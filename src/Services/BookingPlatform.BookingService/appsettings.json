{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BookingDb": ""
  },
  "Postgres": {
    "ApplyMigrationsOnStartup": true
  },
  "Booking": {
    "TimeZoneId": "Europe/Moscow",
    "MaxSlotsRangeDays": 31,
    "MaxBookingsRangeDays": 92,
    "SlotStepMinutes": 15
  },
  "ResourceCatalog": {
    "BaseUrl": "http://resource-service:8080",
    "TimeoutSeconds": 10
  }
}
